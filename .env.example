# ==============================================================================
# Firebase 設定（ダミーキーの雛形ファイル）
# 
# 【使い方】
# 1. このファイルをコピーして「.env」という名前で保存してください（.envは.gitignoreによりGit管理対象外です）
# 2. Firebase管理者からAPIキー等の情報を入手したら、以下のダミー値を実際のものに差し替えてください。
# 3. 実際のキーがなくても、USE_MOCK_DATA=true のまま起動すれば、モック（ダミー）のGoogle認証および
#    対話データ・問題データの取得動作を確認できます。
# ==============================================================================

# モックモードの強制設定 (true: ダミーデータ使用 / false: 実際のFirebaseに接続 / auto: キー未設定時は自動モック)
VITE_USE_MOCK_DATA=auto
USE_MOCK_DATA=auto

# Firebase Web API 設定
# Firebaseコンソールの「プロジェクトの設定」>「全般」>「マイアプリ」>「SDK の設定と構成」から取得できます
FIREBASE_API_KEY=AIzaSyDummyKey_ReplaceWithYourActualKey_1234567890
FIREBASE_AUTH_DOMAIN=cause-analysis-demo.firebaseapp.com
FIREBASE_PROJECT_ID=cause-analysis-demo
FIREBASE_STORAGE_BUCKET=cause-analysis-demo.appspot.com
FIREBASE_MESSAGING_SENDER_ID=100000000000
FIREBASE_APP_ID=1:100000000000:web:dummyappid0123456789abcdef
FIREBASE_MEASUREMENT_ID=G-DUMMY12345

# （任意）Realtime Database を使用している場合のURL
FIREBASE_DATABASE_URL=https://cause-analysis-demo-default-rtdb.firebaseio.com

# サーバー起動ポート（ローカルWebサーバー起動時）
PORT=3000
